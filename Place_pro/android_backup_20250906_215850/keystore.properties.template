# This is a template. Replace the values with your actual keystore information.
# DO NOT COMMIT THIS FILE WITH ACTUAL CREDENTIALS TO VERSION CONTROL.

# Path to your keystore file
storeFile=../keystore/upload-keystore.jks

# Keystore password
storePassword=your_keystore_password

# Key alias
keyAlias=upload

# Key password
keyPassword=your_key_password

# Validity in years
validity=25

# Name of the key
alias=upload

# First and last name of the key owner
name=Your Name

# Organizational unit
organizationalUnit=Your Organization Unit

# Organization name
organization=Your Organization

# City or locality
city=Your City

# State or province
state=Your State

# Two-letter country code
country=US

