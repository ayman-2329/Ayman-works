<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Exclude shared_prefs if they contain sensitive data -->
    <exclude domain="sharedpref" path="sensitive_prefs.xml"/>
    
    <!-- Include app-specific data -->
    <include domain="file" path="app_flutter"/>
    
    <!-- Include database if you have any -->
    <include domain="database" path="app_database"/>
    
    <!-- Exclude cache and temporary files -->
    <exclude domain="file" path="cache"/>
    <exclude domain="file" path="no_backup"/>
    
    <!-- Include any other app-specific files that should be backed up -->
</full-backup-content>
